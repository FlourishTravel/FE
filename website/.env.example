# Backend API (chatbot, tours, auth...). Copy thành .env trong cùng thư mục website/
# Local BE:  http://localhost:8080
# Production: https://flourishtravelapp.khanhtn45.id.vn/api
VITE_API_URL=https://flourishtravelapp.khanhtn45.id.vn/api

# Google Sign-In — Web Client ID (public). Google Cloud Console → Credentials.
VITE_GOOGLE_CLIENT_ID=

# Base path khi build production. GitHub Pages: /FE/ | VPS/Nginx: /
# VITE_BASE=/FE/
